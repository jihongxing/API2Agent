{
  "info": {
    "name": "Postman Demo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.2.3"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.example.com"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:user_id?verbose=true",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":user_id"],
              "query": [
                {
                  "key": "verbose",
                  "value": "true"
                }
              ]
            },
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "trace-123"
              }
            ]
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Demo\",\"active\":true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
