{
  "name": "GitHub GraphQL Demo",
  "version": "1.0.0",
  "endpoint": {
    "url": "https://api.github.com/graphql",
    "method": "POST"
  },
  "auth": {
    "type": "bearer",
    "env": "GITHUB_GRAPHQL_TOKEN"
  },
  "operations": [
    {
      "name": "Get Viewer",
      "operation_name": "GetViewer",
      "type": "query",
      "description": "Fetch a GitHub user by login through a fixed GraphQL query.",
      "query": "query GetViewer($login: String!) { user(login: $login) { login name } }",
      "variables_schema": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": ["login"]
      },
      "example": {
        "login": "octocat"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "Add Star",
      "operation_name": "AddStar",
      "type": "mutation",
      "description": "Add a star through a fixed GraphQL mutation.",
      "query": "mutation AddStar($starrableId: ID!) { addStar(input: {starrableId: $starrableId}) { starrable { id } } }",
      "variables_schema": {
        "type": "object",
        "properties": {
          "starrableId": {
            "type": "string"
          }
        },
        "required": ["starrableId"]
      },
      "example": {
        "starrableId": "repo_123"
      }
    }
  ]
}
